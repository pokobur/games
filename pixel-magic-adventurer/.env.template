# Pixel Magic Adventurer — APIキー設定テンプレート
# このファイルをコピーして `.env` にリネームし、APIキーを設定してください。
# `.env` はgitignoreに追加し、公開しないようにしてください。

# Gemini API キー（音声テキストの安全チェック＆英語プロンプト変換用）
# https://aistudio.google.com/apikey にてAPIキーを取得してください。
VITE_GEMINI_API_KEY=your_gemini_api_key_here

# 画像生成 API キー（Imagen / DALL-E 等）
# Gemini APIキーと同じキーが使用できます（Imagen 3モデルを利用）。
VITE_IMAGE_API_KEY=your_image_api_key_here
